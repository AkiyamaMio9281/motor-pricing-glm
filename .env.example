# Copy to .env and adjust. .env is gitignored.
# These names are read by both docker-compose.yml and scripts/db.py, so the
# container and the clients cannot drift apart.

POSTGRES_DB=motor_pricing
POSTGRES_USER=pricing
POSTGRES_PASSWORD=change_me_locally

# Host-side connection. POSTGRES_HOST is localhost because clients talk to the
# published port, not to the container network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
