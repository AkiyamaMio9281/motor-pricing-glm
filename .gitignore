# Data is fetched, never committed. freMTPL2freq alone is ~678k rows; a CSV that
# size in the history makes every clone pay for it. scripts/fetch_data.py plus
# the checksum in data/CHECKSUMS.txt is the reproducible substitute.
data/*
!data/.gitkeep
!data/CHECKSUMS.txt

# Local environment
.venv/
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# R
.Rhistory
.RData
.Rproj.user/

# Generated exports, rebuilt by the pipeline.
exports/*
!exports/.gitkeep

# Local planning notes for the author, not part of the project.
SPEC.md
docs/commit-plan.md
docs/environment.md
